PORT=3000
DATABASE_URL=postgres://comment_classificator:comment_classificator@localhost:5432/comment_classificator
# A separate database from the one above — repository and integration tests truncate every
# table between cases, so running them against DATABASE_URL would wipe out whatever a
# running `pnpm dev` server is using. docker-compose.yml creates this database
# automatically (only on a fresh volume; see docker/init-test-db.sql).
TEST_DATABASE_URL=postgres://comment_classificator:comment_classificator@localhost:5432/comment_classificator_test
JEV_API_KEY=
# true para clasificar con una categoría aleatoria en vez de llamar a Jev de verdad —
# solo para desarrollo local y demos, mientras no haya una JEV_API_KEY real.
JEV_MOCK_MODE=false
STRIPE_SECRET_KEY=
GOOGLE_CLIENT_ID=
# Signs session tokens issued after Google login. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Provisional default; the real plan size is still an open question (docs/ESPECIFICACION.md,
# "Modelo de negocio y puntos abiertos").
MONTHLY_COMMENT_QUOTA=1000
