{
  "_comment": "Hand-trimmed from a real reply-continuation response on 2026-10-14. Includes a reply-to-reply (replyLevel 2) and a trailing continuationItemRenderer for a 'load more replies' page.",
  "onResponseReceivedEndpoints": [
    {
      "appendContinuationItemsAction": {
        "continuationItems": [
          { "somethingRendererForLevel1Reply": { "commentKey": "c1-reply-1" } },
          { "somethingRendererForLevel2Reply": { "commentKey": "c1-reply-1-reply-1" } },
          {
            "continuationItemRenderer": {
              "trigger": "CONTINUATION_TRIGGER_ON_ITEM_SHOWN",
              "continuationEndpoint": { "continuationCommand": { "token": "SAMPLE_MORE_REPLIES_TOKEN" } }
            }
          }
        ]
      }
    }
  ],
  "frameworkUpdates": {
    "entityBatchUpdate": {
      "mutations": [
        {
          "entityKey": "c1-reply-1",
          "type": "ENTITY_MUTATION_TYPE_REPLACE",
          "payload": {
            "commentEntityPayload": {
              "properties": {
                "commentId": "c1-reply-1",
                "content": { "content": "I agree!" },
                "replyLevel": 1,
                "publishedTime": "5 hours ago"
              },
              "author": { "displayName": "@dave", "avatarThumbnailUrl": "https://yt3.ggpht.com/dave=s88" }
            }
          }
        },
        {
          "entityKey": "c1-reply-1-reply-1",
          "type": "ENTITY_MUTATION_TYPE_REPLACE",
          "payload": {
            "commentEntityPayload": {
              "properties": {
                "commentId": "c1-reply-1-reply-1",
                "content": { "content": "Me too" },
                "replyLevel": 2,
                "publishedTime": "4 hours ago"
              },
              "author": { "displayName": "@erin", "avatarThumbnailUrl": "https://yt3.ggpht.com/erin=s88" }
            }
          }
        }
      ]
    }
  }
}
